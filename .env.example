# Keyholder Environment Configuration
# Copy this to .env.local and fill in actual values (Never commit .env.local)

# ─────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://user:password@localhost:5432/keyholder

# ─────────────────────────────────────────────────────────────────
# YELLOWSTONE (Triton)
# ─────────────────────────────────────────────────────────────────

YELLOWSTONE_ENDPOINT=https://grpc.triton.one:8090
YELLOWSTONE_TOKEN=YOUR_TRITON_API_TOKEN_HERE

# ─────────────────────────────────────────────────────────────────
# ALERTS & NOTIFICATIONS
# ─────────────────────────────────────────────────────────────────

# Telegram Bot API
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# X (Twitter) API
X_API_KEY=YOUR_X_API_KEY
X_API_SECRET=YOUR_X_API_SECRET
X_BOT_ACCOUNT=@SolanaControlPlane

# ─────────────────────────────────────────────────────────────────
# ON-CHAIN: ANCHOR PROGRAM
# ─────────────────────────────────────────────────────────────────

NEXT_PUBLIC_PROGRAM_ID=PLACEHOLDER_PROGRAM_ID_HERE
ANCHOR_PROVIDER_URL=https://api.mainnet-beta.solana.com
ANCHOR_WALLET_PATH=/path/to/wallet.json

# Attester keypair (Ed25519, base58 encoded private key)
# ⚠️  NEVER commit this. Use Fly.io secrets for production.
ATTESTER_KEY=5JKpXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Squads Multisig PDA (for ControlGuard's own authority)
# Deployed day 11, 2-of-3, 48h timelock
SQUADS_MULTISIG_ADDRESS=PLACEHOLDER_SQUADS_ADDRESS

# SAS (Solana Attestation Service)
SAS_PROGRAM_ID=22zoJMtdu4tQc2PzL74ZUT7FrwgB1Udec8DdW4yw4BdG

# ─────────────────────────────────────────────────────────────────
# x402 PAYMENTS
# ─────────────────────────────────────────────────────────────────

X402_MECHANISM=svm
X402_PRICE_USDC=0.001
X402_PAYAI_FACILITATOR=enabled
X402_CDP_FACILITATOR=enabled

# ─────────────────────────────────────────────────────────────────
# WORKER SERVICE
# ─────────────────────────────────────────────────────────────────

LOG_LEVEL=info
NODE_ENV=production
WORKER_PORT=3000

# Ingest service config
INGEST_BATCH_SIZE=1000
INGEST_POLL_INTERVAL_MS=5000

# Verification poller
OTTERSEC_API_URL=https://verify.osec.io
OTTERSEC_POLL_INTERVAL_MS=600000  # 10 minutes

# Attestation writer
ATTESTATION_BATCH_INTERVAL_MS=300000  # 5 minutes

# Alert dispatcher
ALERT_DISPATCH_INTERVAL_MS=5000
TELEGRAM_RATE_LIMIT_PER_MIN=30
EMAIL_RATE_LIMIT_PER_MIN=10

# X Bot (finalized events only)
X_BOT_POST_MIN_SEVERITY=medium  # 'info' | 'low' | 'medium' | 'high' | 'critical'
X_BOT_POST_INTERVAL_MS=60000

# ─────────────────────────────────────────────────────────────────
# VERCEL / NEXT.JS
# ─────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=https://keyholder.vercel.app
VERCEL_PROJECT_ID=YOUR_VERCEL_PROJECT_ID

# SIWS (Sign-In With Solana)
SIWS_MESSAGE_DOMAIN=keyholder.com
SIWS_SESSION_COOKIE_SECURE=true
JWT_SECRET=YOUR_RANDOM_JWT_SECRET_64_CHARS_MIN

# ─────────────────────────────────────────────────────────────────
# EXTERNAL SERVICES
# ─────────────────────────────────────────────────────────────────

# Helius (fallback RPC)
HELIUS_API_KEY=YOUR_HELIUS_API_KEY

# DefiLlama (protocol TVL data)
DEFI_LLAMA_API_URL=https://api.llama.fi

# Jupiter (price feeds for position resolver)
JUPITER_API_URL=https://api.jup.ag

# ─────────────────────────────────────────────────────────────────
# OPTIONAL: OBSERVABILITY
# ─────────────────────────────────────────────────────────────────

# Better Stack / Axiom for log aggregation (free tier)
BETTER_STACK_TOKEN=YOUR_BETTER_STACK_TOKEN
AXIOM_TOKEN=YOUR_AXIOM_TOKEN

# Sentry (error tracking, free tier)
SENTRY_DSN=https://YOUR_SENTRY_DSN

# ─────────────────────────────────────────────────────────────────
# DRIFT REPLAY (Demo Data)
# ─────────────────────────────────────────────────────────────────

# Drift Program ID (for replay and monitoring)
DRIFT_PROGRAM_ID=dRiftyHA39MWEi3S9mjkXDXANrQ1fJ5VmMPckPnnDJiH

# Drift Security Council multisig (at time of replay)
DRIFT_SECURITY_COUNCIL_MULTISIG=GjDdEkdj9NzGJvXpXfg3tBLpbfAREX6SXCE9XhYZBFX

# Archive provider for March 2026 Drift history
DRIFT_ARCHIVE_RPC=https://api.triton.one:8000  # Or Helius archival

# ─────────────────────────────────────────────────────────────────
# CREDENTIALS MANIFEST (For Operations)
# ─────────────────────────────────────────────────────────────────

# Keep this table up-to-date for the team. All values are placeholders.
#
# | Service             | Credential          | Rotation Period | Keeper         |
# |---------------------|---------------------|-----------------|----------------|
# | Triton Yellowstone  | YELLOWSTONE_TOKEN   | Quarterly       | DevOps         |
# | Telegram Bot        | TELEGRAM_BOT_TOKEN  | Never (unused)  | Founder        |
# | X API               | X_API_KEY/SECRET    | Quarterly       | Marketing      |
# | Database            | DATABASE_URL        | Monthly         | DevOps         |
# | Attester            | ATTESTER_KEY        | Post-audit only | DevOps (HSM)   |
# | Resend Email        | RESEND_API_KEY      | Quarterly       | DevOps         |
# | JWT Secret          | JWT_SECRET          | Monthly         | DevOps         |
