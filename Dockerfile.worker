# Keyholder worker (apps/worker/src/runner.ts) for Fly.io. Builds the workspace
# packages it imports, then runs the runner with tsx (as in development).
FROM node:22-slim
RUN corepack enable
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.json ./
COPY packages ./packages
COPY apps/worker ./apps/worker
RUN pnpm install --frozen-lockfile --filter @keyholder/worker... \
 && pnpm --filter @keyholder/decoder --filter @keyholder/risk --filter @keyholder/sdk build
WORKDIR /app/apps/worker
ENV NODE_ENV=production
CMD ["npx", "tsx", "src/runner.ts"]
